#!/bin/bash
### BEGIN INIT INFO
# Provides: omxplayer
# Required-Start: $network $local_fs dbus cron
# Required-Stop:
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Short-Description: Displays camera feeds for monitoring
# Description:
### END INIT INFO

# Exit on error, undefined variables, and pipe failures
set -e
set -u
set -o pipefail

# version:0.8.3

# Source all functions
source "/usr/lib/displaycameras/functions.sh"
source "/usr/lib/displaycameras/player.sh"

# Exit if not root
if [[ $EUID -ne 0 ]]; then
   error "This script must be run as root"
   exit 1
fi

# Exit if omxplayer_dbuscontrol is not executable and in the PATH
if ! command_exists omxplayer_dbuscontrol; then
   error "omxplayer_dbuscontrol not found in PATH or not executable"
   exit 1
fi

# Exit if omxplayer is not executable and in the PATH
if ! command_exists omxplayer; then
   error "omxplayer not found in PATH or not executable"
   exit 1
fi

# Check core runtime dependencies
for cmd in pgrep pkill timeout; do
    if ! command_exists "$cmd"; then
        error "$cmd not found in PATH — required for process management"
        exit 1
    fi
done

# Verify library directory exists
if [ ! -d /usr/lib/displaycameras ]; then
    error "/usr/lib/displaycameras directory not found — re-run install.sh"
    exit 1
fi
for lib in logging.sh stream.sh network.sh system.sh rotation.sh service.sh player.sh; do
    if [ ! -f "/usr/lib/displaycameras/$lib" ]; then
        error "Library /usr/lib/displaycameras/$lib not found — re-run install.sh"
        exit 1
    fi
done

# Load configuration
if [ -f /etc/displaycameras/displaycameras.conf ]; then
   source /etc/displaycameras/displaycameras.conf
else
   error "/etc/displaycameras/displaycameras.conf does not exist or is not readable."
    exit 1
fi

# Validate config-dependent runtime dependencies
if [ "${blank-}" = "true" ] && ! command_exists fbi; then
    error "blank=true is set but fbi is not installed (needed for screen blanking)"
    exit 1
fi
if [ "${displaydetect-}" = "true" ] && ! command_exists fbset; then
    warn "displaydetect=true is set but fbset is not installed — layout scaling disabled"
fi
if ! command_exists bc; then
    error "bc is not installed — required for layout generation and arithmetic"
    exit 1
fi

# Function to generate a new layout file based on the default
generate_layout_file() {
    local resolution="$1"
    local default_layout="/etc/displaycameras/layout.conf.default"
    local new_layout_file="/etc/displaycameras/layout.conf.$resolution"
    
    info "Attempting to generate new layout file for $resolution..."

    if [ ! -f "$default_layout" ]; then
        error "Default layout file '$default_layout' not found. Cannot generate new layout."
        return 1
    fi

    # Extract target dimensions
    local target_w=$(echo "$resolution" | cut -d'x' -f1)
    local target_h=$(echo "$resolution" | cut -d'x' -f2)

    # Track the subshell exit status
    local result=0
    (
        source "$default_layout"
        
        # Determine source dimensions from the default layout's positions
        local max_x2=0
        local max_y2=0
        for pos in "${window_positions[@]}"; do
            local x2=$(echo "$pos" | awk '{print $3}')
            local y2=$(echo "$pos" | awk '{print $4}')
            if [ "$x2" -gt "$max_x2" ]; then max_x2=$x2; fi
            if [ "$y2" -gt "$max_y2" ]; then max_y2=$y2; fi
        done
        
        local source_w=${max_x2:-1920}
        local source_h=${max_y2:-1080}
        
        if [ "$source_w" -eq 0 ] || [ "$source_h" -eq 0 ]; then
            warn "Could not determine source resolution from default layout. Assuming 1920x1080."
            source_w=1920
            source_h=1080
        fi

        # Calculate new window positions
        local new_positions=()
        for pos in "${window_positions[@]}"; do
            local x1=$(echo "$pos" | awk '{print $1}')
            local y1=$(echo "$pos" | awk '{print $2}')
            local x2=$(echo "$pos" | awk '{print $3}')
            local y2=$(echo "$pos" | awk '{print $4}')

            local new_x1=$(printf "%.0f" $(echo "scale=4; $x1 * $target_w / $source_w" | bc))
            local new_y1=$(printf "%.0f" $(echo "scale=4; $y1 * $target_h / $source_h" | bc))
            local new_x2=$(printf "%.0f" $(echo "scale=4; $x2 * $target_w / $source_w" | bc))
            local new_y2=$(printf "%.0f" $(echo "scale=4; $y2 * $target_h / $source_h" | bc))
            
            new_positions+=("$new_x1 $new_y1 $new_x2 $new_y2")
        done

        # Create the new layout file by replacing the window_positions block
        local temp_file=$(mktemp)
        cleanup_temp() { rm -f "$temp_file"; }
        trap cleanup_temp EXIT
        local header_added=false
        local in_block=false
        
        while IFS= read -r line; do
            if [[ "$line" == "window_positions=("* ]]; then
                # Print the auto-generation header and the new block
                if ! $header_added; then
                    echo -e "# Auto-generated layout for $resolution on $(date)\n# Based on $default_layout" >> "$temp_file"
                    header_added=true
                fi
                echo -e "window_positions=(" >> "$temp_file"
                for new_pos in "${new_positions[@]}"; do
                    echo -e "    $new_pos" >> "$temp_file"
                done
                echo ")" >> "$temp_file"
                in_block=true
            elif $in_block && [[ "$line" =~ ^[[:space:]]*\)[[:space:]]*$ ]]; then
                in_block=false # End of block, do nothing
            elif ! $in_block; then
                echo "$line" >> "$temp_file"
            fi
        done < "$default_layout"
        
        mv "$temp_file" "$new_layout_file"
    ) || result=$?
    
    if [ $result -ne 0 ]; then
        error "Failed to generate new layout file."
        rm -f "$new_layout_file" # Clean up failed attempt
        return 1
    else
        info "Successfully generated new layout file: $new_layout_file"
        chown root:root "$new_layout_file"
        chmod 0644 "$new_layout_file"
        return 0
    fi
}

# Load layout configuration
if [ "${displaydetect-}" = "true" ] && command_exists fbset; then
    resolution=$(fbset -s | awk '/geometry/ {print $2"x"$3}')
    layout_file="/etc/displaycameras/layout.conf.$resolution"
    if [ -f "$layout_file" ]; then
        info "Detected resolution $resolution, loading layout from $layout_file"
        source "$layout_file"
    else
        if generate_layout_file "$resolution"; then
            source "$layout_file"
        elif [ -f "/etc/displaycameras/layout.conf.default" ]; then
            warn "Layout generation failed. Falling back to default layout."
            source "/etc/displaycameras/layout.conf.default"
        else
            error "Layout generation failed and no default layout is available."
            exit 1
        fi
    fi
else
    if [ -f /etc/displaycameras/layout.conf ]; then
       source /etc/displaycameras/layout.conf
    elif [ -f /etc/displaycameras/layout.conf.default ]; then
       source /etc/displaycameras/layout.conf.default
    else
       error "/etc/displaycameras/layout.conf.default does not exist or is not readable."
       exit 1
    fi
fi

# Validate the loaded camera configuration before proceeding
validate_camera_config || {
    error "Camera configuration validation failed. Check layout file."
    exit 1
}

# Define PID files at the top with other variables
PIDFILE="/var/run/displaycameras.pid"
ROTATE_PIDFILE="/var/run/displaycameras.rotate.pid"
MONITOR_PIDFILE="/var/run/displaycameras.monitor.pid"
DISPLAY_SEQUENCE_FILE="/var/run/displaycameras.sequence"

# Ensure there is an omxplayer timeout value
if [ -z "${omx_timeout-}" ]; then
   omx_timeout=30
fi

# Ensure per-camera timeouts array exists (backward compat with old layout files)
if [ -z "${camera_timeouts+set}" ] || [ ${#camera_timeouts[@]} -eq 0 ]; then
    camera_timeouts=()
    for i in ${!camera_names[@]}; do
        camera_timeouts[$i]="$omx_timeout"
    done
fi

if [ ! -f "$DISPLAY_SEQUENCE_FILE" ]; then
    echo 0 > "$DISPLAY_SEQUENCE_FILE"
fi
declare -i DISPLAY_SEQUENCE
DISPLAY_SEQUENCE=$(cat "$DISPLAY_SEQUENCE_FILE")

# How many cameras do we have?
cameras="${#camera_names[@]}"
# Set the max camera rotation sequence as one less than the number of cameras
# (since it starts at zero).
max_seq=$((cameras-1))
# Initialize seq_step with a default value if not set
: ${seq_step:=1}
# Ensure sequence step value is reasonable
if [ "$seq_step" -gt "$max_seq" ] || [ "$seq_step" -lt "1" ]; then
   seq_step=1
fi

case "$1" in
start)
    info "Displaycameras service starting..."
    log_event "service.start"
    
    # Prevent duplicate start: if PID file exists and process is alive, bail out.
    if [ -f "$PIDFILE" ]; then
        existing_pid=$(cat "$PIDFILE")
        if kill -0 "$existing_pid" 2>/dev/null; then
            info "Displaycameras is already running (PID $existing_pid). Skipping start."
            exit 0
        else
            warn "Stale PID file found. Removing and continuing start."
            rm -f "$PIDFILE"
        fi
    fi
    
    # Write PID file immediately — the monitor loop checks for it on first iteration.
    write_pid_file
    
    # Kill any existing omxplayer processes
    info "Terminating existing omxplayer processes..."
    timeout 10 pkill -f "omxplayer" 2>/dev/null || true
    sleep 1
    
    if [ "${blank-}" = "true" ]; then
        info "Blanking screen"
        if command_exists fbi; then
            fbi -T 2 --noverbose /usr/bin/black.png >/dev/null 2>&1
        fi
    fi
    
    # Start all streams
    feedfailure=false
    
    for i in ${!camera_feeds[@]}; do
        start_stream "$i"
        sleep "${startsleep-5}"
        
        # Check if stream started successfully
        if ! check_stream_health "${camera_names[$i]}"; then
            feedfailure=true
        fi
    done
    
    if [ "$feedfailure" = "true" ]; then
        info "One or more feeds failed to start. Initiating repair procedure..."
        for i in ${!camera_feeds[@]}; do
            if ! check_stream_health "${camera_names[$i]}"; then
                repair_stream "$i" || warn "Startup repair for ${camera_names[$i]} could not acquire lock (already repairing)"
            fi
        done
    fi
    
    # Start rotation if configured
    if [ "${rotate-}" = "true" ]; then
        info "Initializing camera rotation..."
        start_rotation
    fi
    
    # Start monitoring process
    info "Starting stream monitoring process..."
    monitor_omxplayer_processes &
    echo $! > "${MONITOR_PIDFILE}.tmp" && mv "${MONITOR_PIDFILE}.tmp" "$MONITOR_PIDFILE"
    info "Monitoring process started with PID: $(cat $MONITOR_PIDFILE)"
    info "Displaycameras service started successfully."
    log_event "service.started"
    
    # Supervisor loop — runs as the main process. Systemd (Type=simple)
    # tracks this PID. If rotation or monitor die, exit non-zero and
    # systemd restarts via Restart=on-failure.
    while true; do
        if [ -f "$ROTATE_PIDFILE" ]; then
            rpid=$(cat "$ROTATE_PIDFILE")
            if ! kill -0 "$rpid" 2>/dev/null; then
                error "Rotation process (PID $rpid) died unexpectedly — exiting for restart"
                exit 1
            fi
        fi
        if [ -f "$MONITOR_PIDFILE" ]; then
            mpid=$(cat "$MONITOR_PIDFILE")
            if ! kill -0 "$mpid" 2>/dev/null; then
                error "Monitor process (PID $mpid) died unexpectedly — exiting for restart"
                exit 1
            fi
        fi
        sleep 10
    done
    ;;
    
stop)
    info "Displaycameras service stopping..."
    log_event "service.stop"
    if [ -f "$PIDFILE" ]; then
        cleanup_pid_files
        info "Terminating omxplayer processes..."
        timeout 10 pkill -f "omxplayer" 2>/dev/null || true
        sleep 1
        # Ensure dbus-daemon cleanup
        timeout 5 pkill -f "dbus-daemon.*omxplayer" 2>/dev/null || true
        cleanup_dbus_files
        if [ "${blank-}" = "true" ]; then
            if command_exists fbi; then
                fbi -T 2 --noverbose /usr/bin/black.png >/dev/null 2>&1
            fi
        fi
    fi
    info "Displaycameras service stopped."
    ;;
    
restart)
    info "Restarting displaycameras service..."
    $0 stop
    sleep 1
    $0 start
    ;;
    
repair)
    if [ ! -f "$PIDFILE" ]; then 
        warn "Repair command issued, but service is not running."
        exit 0
    fi
    
    info "Starting repair procedure..."
    for i in ${!camera_feeds[@]}; do
        if ! check_stream_health "${camera_names[$i]}"; then
            repair_stream "$i"
        fi
    done
    info "Repair procedure finished."
    ;;
    
status)
    echo "Camera Display Status:"
    echo "===================="
    echo
    
    if check_service_status; then
        # Get system resources
        mem_total=$(free -m | awk '/^Mem:/{print $2}')
        mem_used=$(free -m | awk '/^Mem:/{print $3}')
        mem_percent=$((mem_used * 100 / mem_total))
        cpu_load=$(awk 'NR==1 {u=$2+$3+$4+$6+$7+$8; t=u+$5; if(t>0) printf "%.0f", u*100/t; else print "0"; exit}' /proc/stat)
        
        echo "System Resources:"
        echo "----------------"
        echo "Memory Usage: ${mem_used}MB / ${mem_total}MB (${mem_percent}%)"
        echo "CPU Load: ${cpu_load}%"
        echo
        
        echo "Stream Status:"
        echo "-------------"
        any_playing=false
        for name in "${camera_names[@]}"; do
            status=$(timeout 2s omxplayer_dbuscontrol "$name" getplaystatus 2>/dev/null || echo "Not running")
            position=$(timeout 2s omxplayer_dbuscontrol "$name" getposition 2>/dev/null || echo "0")
            if [ "$status" = "Playing" ]; then
                echo "$name: $status (Position: $position)"
                any_playing=true
            else
                echo "$name: Not running"
            fi
        done
        echo
        
        # Check for preloaded streams
        echo "Preloaded Streams:"
        echo "----------------"
        preloaded=false
        for name in "${camera_names[@]}"; do
            if pgrep -f "omxplayer.*preload.*$name" >/dev/null; then
                echo "$name: Preloaded"
                preloaded=true
            fi
        done
        if [ "$preloaded" = "false" ]; then
            echo "No preloaded streams"
        fi
        echo
        
        # Check rotation status
        echo "Rotation Status:"
        echo "--------------"
        if check_rotation_status; then
            echo "Rotation: Active"
            echo "Delay: ${rotatedelay-10} seconds"
        else
            if [ "${rotate-}" = "true" ]; then
                echo "Rotation: Configured but not running"
            else
                echo "Rotation: Disabled"
            fi
        fi
    else
        echo "Service is NOT running"
        if [ -f "$PIDFILE" ]; then
            echo "WARNING: PID file exists but service is not running"
            echo "Run 'sudo /usr/bin/displaycameras restart' to fix this"
        fi
    fi
    exit 0
    ;;
    
*)
    echo "Usage: /usr/bin/displaycameras {start|stop|restart|repair|status}"
    exit 1
    ;;
esac
