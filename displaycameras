#!/bin/bash
### BEGIN INIT INFO
# Provides: omxplayer
# Required-Start: $network $local_fs dbus cron
# Required-Stop:
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Short-Description: Displays camera feeds for monitoring
# Description:
### END INIT INFO

# Exit on error and undefined variables
set -e
set -u

# version:0.8.3

# Source all functions
source "/usr/lib/displaycameras/functions.sh"

# Exit if not root
if [[ $EUID -ne 0 ]]; then
   log "ERROR" "This script must be run as root"
   exit 1
fi

# Exit if omxplayer_dbus is not executable and in the PATH
if ! command_exists omxplayer_dbuscontrol; then
   log "ERROR" "omxplayer_dbuscontrol not found in PATH or not executable"
   exit 1
fi

# Load configuration
if [ -f /etc/displaycameras/displaycameras.conf ]; then
   source /etc/displaycameras/displaycameras.conf
else
   log "ERROR" "/etc/displaycameras/displaycameras.conf does not exist or is not readable."
   exit 1
fi

# Load layout configuration
if [ -f /etc/displaycameras/layout.conf ]; then
   source /etc/displaycameras/layout.conf
elif [ -f /etc/displaycameras/layout.conf.default ]; then
   source /etc/displaycameras/layout.conf.default
else
   log "ERROR" "/etc/displaycameras/layout.conf.default does not exist or is not readable."
   exit 1
fi

# Define PID files at the top with other variables
PIDFILE="/var/run/displaycameras.pid"
ROTATE_PIDFILE="/var/run/displaycameras.rotate.pid"
MONITOR_PIDFILE="/var/run/displaycameras.monitor.pid"
DISPLAY_SEQUENCE_FILE="/var/run/displaycameras.sequence"

# Ensure there is an omxplayer timeout value
if [ -z "${omx_timeout-}" ]; then
   omx_timeout=30
fi

if [ ! -f "$DISPLAY_SEQUENCE_FILE" ]; then
    echo 0 > "$DISPLAY_SEQUENCE_FILE"
fi
declare -i DISPLAY_SEQUENCE
DISPLAY_SEQUENCE=$(cat "$DISPLAY_SEQUENCE_FILE")

# Define window positions (x1 y1 x2 y2)
window_positions=(
    "0 0 1200 1080"      # Position 1 (left full)
    "1200 0 1920 360"    # Position 2 (right top)
    "1200 360 1920 720"  # Position 3 (right middle)
    "1200 720 1920 1080" # Position 4 (right bottom)
)

# How many cameras do we have?
cameras="${#camera_names[@]}"
# Set the max camera rotation sequence as one less than the number of cameras
# (since it starts at zero).
max_seq=$((cameras-1))
# Initialize seq_step with a default value if not set
: ${seq_step:=1}
# Ensure sequence step value is reasonable
if [ "$seq_step" -gt "$max_seq" ] || [ "$seq_step" -lt "1" ]; then
   seq_step=1
fi

case "$1" in
start)
    log "INFO" "Displaycameras service starting..."
    write_pid_file
    
    # Kill any existing omxplayer processes
    log "INFO" "Terminating existing omxplayer processes..."
    pkill -f "omxplayer" || true
    sleep 1
    
    if [ "${blank-}" = "true" ]; then
        log "INFO" "Blanking screen"
        if command_exists fbi; then
            fbi -T 2 --noverbose /usr/bin/black.png >/dev/null 2>&1
        fi
    fi
    
    # Start all streams
    feedfailure=false
    
    for i in ${!camera_feeds[@]}; do
        start_stream "$i"
        sleep "${startsleep-5}"
        
        # Check if stream started successfully
        if ! check_stream_health "${camera_names[$i]}"; then
            feedfailure=true
        fi
    done
    
    if [ "$feedfailure" = "true" ]; then
        log "INFO" "One or more feeds failed to start. Initiating repair procedure..."
        for i in ${!camera_feeds[@]}; do
            if ! check_stream_health "${camera_names[$i]}"; then
                repair_stream "$i"
            fi
        done
    fi
    
    # Start rotation if configured
    if [ "${rotate-}" = "true" ]; then
        log "INFO" "Initializing camera rotation..."
        start_rotation
    fi
    
    # Start monitoring process
    log "INFO" "Starting stream monitoring process..."
    monitor_omxplayer_processes &
    echo $! > "$MONITOR_PIDFILE"
    log "INFO" "Monitoring process started with PID: $(cat $MONITOR_PIDFILE)"
    log "INFO" "Displaycameras service started successfully."
    ;;
    
stop)
    log "INFO" "Displaycameras service stopping..."
    if [ -f "$PIDFILE" ]; then
        cleanup_pid_files
        log "INFO" "Terminating omxplayer processes..."
        pkill -f "omxplayer" || true
        if [ "${blank-}" = "true" ]; then
            if command_exists fbi; then
                fbi -T 2 --noverbose /usr/bin/black.png >/dev/null 2>&1
            fi
        fi
    fi
    log "INFO" "Displaycameras service stopped."
    ;;
    
restart)
    log "INFO" "Restarting displaycameras service..."
    $0 stop
    sleep 1
    $0 start
    ;;
    
repair)
    if [ ! -f "$PIDFILE" ]; then 
        log "WARN" "Repair command issued, but service is not running."
        exit 0
    fi
    
    log "INFO" "Starting repair procedure..."
    for i in ${!camera_feeds[@]}; do
        if ! check_stream_health "${camera_names[$i]}"; then
            repair_stream "$i"
        fi
    done
    log "INFO" "Repair procedure finished."
    ;;
    
status)
    echo "Camera Display Status:"
    echo "===================="
    echo
    
    if check_service_status; then
        # Get system resources
        mem_total=$(free -m | awk '/^Mem:/{print $2}')
        mem_used=$(free -m | awk '/^Mem:/{print $3}')
        mem_percent=$((mem_used * 100 / mem_total))
        cpu_load=$(top -bn1 | grep "Cpu(s)" | awk '{print $2}' | cut -d. -f1)
        
        echo "System Resources:"
        echo "----------------"
        echo "Memory Usage: ${mem_used}MB / ${mem_total}MB (${mem_percent}%)"
        echo "CPU Load: ${cpu_load}%"
        echo
        
        echo "Stream Status:"
        echo "-------------"
        any_playing=false
        for name in "${camera_names[@]}"; do
            status=$(omxplayer_dbuscontrol "$name" getplaystatus 2>/dev/null || echo "Not running")
            position=$(omxplayer_dbuscontrol "$name" getposition 2>/dev/null || echo "0")
            if [ "$status" = "Playing" ]; then
                echo "$name: $status (Position: $position)"
                any_playing=true
            else
                echo "$name: Not running"
            fi
        done
        echo
        
        # Check for preloaded streams
        echo "Preloaded Streams:"
        echo "----------------"
        preloaded=false
        for name in "${camera_names[@]}"; do
            if pgrep -f "omxplayer.*preload.*$name" >/dev/null; then
                echo "$name: Preloaded"
                preloaded=true
            fi
        done
        if [ "$preloaded" = "false" ]; then
            echo "No preloaded streams"
        fi
        echo
        
        # Check rotation status
        echo "Rotation Status:"
        echo "--------------"
        if check_rotation_status; then
            echo "Rotation: Active"
            echo "Delay: ${rotatedelay-10} seconds"
        else
            if [ "${rotate-}" = "true" ]; then
                echo "Rotation: Configured but not running"
            else
                echo "Rotation: Disabled"
            fi
        fi
    else
        echo "Service is NOT running"
        if [ -f "$PIDFILE" ]; then
            echo "WARNING: PID file exists but service is not running"
            echo "Run 'sudo /usr/bin/displaycameras restart' to fix this"
        fi
    fi
    exit 0
    ;;
    
*)
    echo "Usage: /usr/bin/displaycameras {start|stop|restart|repair|status}"
    exit 1
    ;;
esac
