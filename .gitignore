# displaycameras project gitignore

# --- OS / Editor Artifacts ---
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# --- Environment / Config ---
.env
.env.local

# --- Build / Temp / Cache ---
*.tmp
*.temp
*.cache
tmp/

# --- Logs ---
*.log

# --- Node / Python artifacts (if ever added) ---
node_modules/
__pycache__/
*.pyc
*.pyo

# --- Running config (use .example files as templates) ---
displaycameras.conf
layout.conf.default
layout.conf.1920x1080
layout.conf

# --- Project docs / internal tooling ---
docs/
.kilo/
