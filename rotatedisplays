#!/bin/bash

# Exit on error and undefined variables
set -e
set -u

# Set default values
sleep_time=${1:-5}          # Default: 5 seconds
seq_step=${2:-1}            # Default: 1 (forward rotation)

# Validate inputs
if ! [[ "$sleep_time" =~ ^[0-9]+$ ]]; then
    echo "Error: Sleep time must be a number"
    exit 1
fi

if ! [[ "$seq_step" =~ ^[0-9]+$ ]]; then
    echo "Error: Sequence step must be a number"
    exit 1
fi

# Main rotation loop
for i in $(seq 1 11); do
    sleep "$sleep_time"
    if [ "$seq_step" -gt 1 ]; then
        /usr/bin/displaycameras rotaterev >/dev/null 2>&1
    else
        /usr/bin/displaycameras rotate >/dev/null 2>&1
    fi
done

# Restart the rotation process in the background
"$0" "$sleep_time" "$seq_step" &
exit 0