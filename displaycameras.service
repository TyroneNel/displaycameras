[Unit]
Documentation=man:systemd-sysv-generator(8)
Description=Displays camera feeds for monitoring
Before=multi-user.target
After=network-online.target
After=dbus.service
After=cron.service
Wants=network-online.target

[Service]
# Type=oneshot with RemainAfterExit=yes keeps the service marked active after
# ExecStart completes. The start command blocks on 'wait' so it stays alive
# as long as the background rotation/monitor loops run. Systemd cannot detect
# if those background processes crash -- they are monitored internally via
# PID files and the cron-based repair job.
Type=oneshot
Restart=no
TimeoutSec=5min
IgnoreSIGPIPE=no
LimitNPROC=1
KillMode=control-group
GuessMainPID=no
RemainAfterExit=yes
SuccessExitStatus=5 6
ExecStart=/usr/bin/displaycameras start
ExecStop=/usr/bin/displaycameras stop
ExecReload=/usr/bin/displaycameras restart

[Install]
WantedBy=multi-user.target
