[Unit]
Documentation=man:systemd-sysv-generator(8)
Description=Displays camera feeds for monitoring
Before=multi-user.target
After=network-online.target
After=dbus.service
After=cron.service
Wants=network-online.target

[Service]
# Type=simple: systemd tracks the main process directly. The start command
# launches streams, rotation, and monitor loops, then enters a supervisor
# loop that checks children every 10s. If rotation or monitor die, the
# main process exits non-zero and systemd restarts via Restart=on-failure.
# SIGTERM triggers graceful shutdown via the handle_signal() trap.
Type=simple
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
IgnoreSIGPIPE=no
LimitNPROC=1
KillMode=control-group
ExecStart=/usr/bin/displaycameras start
ExecStop=/usr/bin/displaycameras stop
ExecReload=/usr/bin/displaycameras restart

[Install]
WantedBy=multi-user.target
